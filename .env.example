# =============================================================================
# VisionFlow 환경변수 예시 (.env.example)
# 사용법: 이 파일을 복사해 저장소 루트에 `.env.local` 로 저장하고 실제 값을 채우세요.
#   cp .env.example .env.local
# 로더: apps/next.config.mjs 가 저장소 루트의 .env / .env.production / .env.local 을 읽습니다.
# =============================================================================

# --- Supabase (필수) ---------------------------------------------------------
# Supabase Dashboard > Project Settings > Data API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Dashboard > Project Settings > API Keys
# anon(public) key. Authorization Bearer JWT 로 사용되므로 반드시 필요.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role key (서버 전용, 절대 클라이언트에 노출 금지). 관리자/검색 API 에서 사용.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase (선택) ---------------------------------------------------------
# 새로운 publishable 키를 쓰는 경우 apikey 헤더용으로 사용. 없으면 anon 키가 대체됨.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# REST 엔드포인트를 직접 지정할 때만. 미설정 시 URL + /rest/v1 로 자동 구성.
# NEXT_PUBLIC_SUPABASE_REST_URL=https://YOUR-PROJECT-REF.supabase.co/rest/v1

# --- Auth (필수) -------------------------------------------------------------
# 세션 서명용 시크릿. 생성: `openssl rand -base64 32`
AUTH_SECRET=your-auth-secret
# 배포 도메인. 로컬은 미설정 시 http://localhost:3000 사용.
# AUTH_URL=http://localhost:3000

# --- Spring 백엔드 (FAQ 이관, 서버 전용) -------------------------------------
# visionflow-server(Spring Boot) base URL. Next API 라우트가 FAQ를 이 백엔드로 위임한다.
# NEXT_PUBLIC_ 접두사 없음 → 브라우저 미노출(같은 오리진 Next 라우트만 호출). 미설정 시 로컬 기본값 사용.
# API_BASE_URL=http://localhost:8080

# Spring 어드민 API 인증용 HMAC 공유 비밀. BFF가 이 값으로 HS256 JWT를 서명하고,
# Spring이 동일 값(BACKEND_JWT_SECRET)으로 검증한다. 반드시 백엔드와 "동일한" 값,
# HS256 규격상 32바이트 이상. 생성 예: `openssl rand -base64 32`
BACKEND_JWT_SECRET=your-shared-hmac-secret-at-least-32-bytes
# 발급자(iss) 클레임. Spring 측 BACKEND_JWT_ISSUER 와 일치해야 함(기본값 visionflow-bff).
# BACKEND_JWT_ISSUER=visionflow-bff

# --- 검색 AI (선택, /api/search 에서 사용) -----------------------------------
# GEMINI_API_KEY=
# OPENAI_API_KEY=
