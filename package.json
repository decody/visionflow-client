{
  "name": "visionflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @visionflow/web --filter @visionflow/admin dev",
    "dev:web": "pnpm --filter @visionflow/web dev",
    "dev:admin": "pnpm --filter @visionflow/admin dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "eslint": "10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2"
  }
}
