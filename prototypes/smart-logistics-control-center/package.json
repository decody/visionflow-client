{
  "name": "@visionflow/smart-logistics-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3015",
    "build": "next build",
    "start": "next start -p 3015",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:ws": "node --import tsx --test server/ws-smoke.test.ts",
    "test:p0": "pnpm test:ws && pnpm test:e2e",
    "perf:browser": "playwright test -c e2e/perf-playwright.config.ts",
    "ws:server": "node --import tsx server/ws-server.ts",
    "perf": "node --import tsx --expose-gc server/perf-bench.ts"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.1.0",
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/geo-layers": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/mesh-layers": "^9.1.0",
    "@deck.gl/react": "^9.1.0",
    "@luma.gl/engine": "^9.1.0",
    "@tanstack/react-query": "5.66.0",
    "next": "16.2.4",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "ws": "8.18.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.5.13",
    "tsx": "4.20.3",
    "typescript": "6.0.3"
  }
}
