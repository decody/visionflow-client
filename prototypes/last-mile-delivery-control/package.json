    "overlayscrollbars-react": "^0.5.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "ws": "8.18.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.5.13",
    "tsx": "4.20.3",
    "typescript": "6.0.3"
