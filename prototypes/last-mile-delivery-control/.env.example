# WebSocket server
WS_PORT=3014
# 개발 데모에서는 비워두면 토큰 없이 supervisor로 동작한다.
WS_AUTH_TOKENS=demo-viewer=OP-VIEWER:viewer,demo-dispatcher=OP-DISPATCHER:dispatcher
# WS_JWT_SECRET=replace-with-a-long-random-secret
WS_STATE_SCOPE=shared
WS_MAX_PAYLOAD_BYTES=65536
WS_COMMANDS_PER_WINDOW=60
WS_AUDIT_LOG=./runtime/ws-audit.jsonl

# Next.js browser client
NEXT_PUBLIC_WS_URL=ws://localhost:3014
# WS_AUTH_TOKENS 또는 WS_JWT_SECRET과 맞는 token
NEXT_PUBLIC_WS_TOKEN=demo-dispatcher
