#!/bin/sh

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "[pre-commit] running typecheck"
if command -v pnpm >/dev/null 2>&1; then
  pnpm -r typecheck
else
  corepack pnpm -r typecheck
fi
status=$?

if [ $status -ne 0 ]; then
  echo "[pre-commit] typecheck failed; commit blocked."
  exit $status
fi
