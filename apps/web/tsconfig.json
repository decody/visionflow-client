{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "incremental": true,
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "paths": {
      "@/*": ["./src/*"],
      "@visionflow/auth": ["../../packages/auth/index.ts"],
      "@visionflow/routes": ["../../packages/routes/src/index.ts"],
      "@visionflow/shared": ["../../packages/shared/src/index.ts"]
    },
    "plugins": [{ "name": "next" }],
    "types": ["node"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "next.config.mjs"],
  "exclude": ["node_modules"]
}
